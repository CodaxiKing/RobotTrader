{
  "name": "petlive-office",
  "version": "0.1.0",
  "description": "Escritório virtual 3D isométrico dos robôs que desenvolvem o SaaS PetLive (P.O, devs, QA e melhorias)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080 --host",
