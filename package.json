    "motor": "node motor/server.mjs",
    "motor:dry": "node motor/server.mjs --dry-run",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.308",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^5.4.21"
  }
}
