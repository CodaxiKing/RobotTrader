# Conta da Anthropic que os robôs usam. Este arquivo (motor/.env) fica fora do git; depois de mudar, reinicie o motor.
#
# Plano de assinatura (Pro/Max) de outra conta: rode `npm run motor:token`, entre no navegador com a conta
# que os robôs devem usar e cole aqui o token que aparecer no terminal (vale 1 ano).
CLAUDE_CODE_OAUTH_TOKEN=
#
# Ou cobrança por uso (Console): uma chave de API. Se preenchida, ela vence o token acima.
ANTHROPIC_API_KEY=
